{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konvert",
  "version": "0.1.0",
  "identifier": "app.konvert.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Конверт",
        "width": 400,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Шифрование файлов перетаскиванием",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "age"
        ],
        "name": "Конверт age",
        "description": "Файл, зашифрованный в формате age",
        "role": "Editor",
        "mimeType": "application/x-age-encryption"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "ru-RU"
      },
      "nsis": {
        "languages": [
          "Russian"
        ]
      }
    }
  }
}
